; Static typechecking of every Charkha contract.
;
; On Pact 4 this file ran formal verification with (verify) and (env-dynref),
; which invoked the Z3 prover on each module's @model properties. Pact 5
; removed both REPL functions. What remains is (typecheck), which checks types
; statically (and is stricter than Pact 4 about mixing integer and decimal)
; but does NOT evaluate @model properties, which are now documentation only.
; This file runs on both Pact 4.13 and Pact 5.4.
(load "setup.repl")
(env-data {})
(env-sigs [])

(print "\n----- TYPECHECK -----\n")

(typecheck "free.charkha-oracle")
(print "typecheck OK: free.charkha-oracle")

(typecheck "free.KETH")
(print "typecheck OK: free.KETH")

(typecheck "free.CHRK")
(print "typecheck OK: free.CHRK")

(typecheck "free.cwKDA")
(print "typecheck OK: free.cwKDA")

(typecheck "free.cwKETH")
(print "typecheck OK: free.cwKETH")

(typecheck "free.cwCHRK")
(print "typecheck OK: free.cwCHRK")

(typecheck "free.charkha-governance")
(print "typecheck OK: free.charkha-governance")

(typecheck "free.charkha-controller")
(print "typecheck OK: free.charkha-controller")
